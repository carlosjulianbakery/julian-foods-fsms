{
  "buildCommand": "rm -rf .next/cache && npx prisma generate && next build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/inventory/check-stock-levels?slot=utc7",
      "schedule": "20 7 * * *"
    },
    {
      "path": "/api/inventory/check-stock-levels?slot=utc8",
      "schedule": "20 8 * * *"
    },
    {
      "path": "/api/cron/shipstation-sync?slot=utc7",
      "schedule": "40 7 * * *"
    },
    {
      "path": "/api/cron/shipstation-sync?slot=utc8",
      "schedule": "40 8 * * *"
    },
    {
      "path": "/api/forms/monthly-cleaning/auto-submit",
      "schedule": "59 7 28-31 * *"
    },
    {
      "path": "/api/cron/sop-review-reminders?slot=utc7",
      "schedule": "5 7 * * *"
    },
    {
      "path": "/api/cron/sop-review-reminders?slot=utc8",
      "schedule": "5 8 * * *"
    },
    {
      "path": "/api/cron/task-generator?slot=utc7",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/task-generator?slot=utc8",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/monthly-cleaning-624-auto-submit",
      "schedule": "10 8 1-3 * *"
    }
  ]
}
